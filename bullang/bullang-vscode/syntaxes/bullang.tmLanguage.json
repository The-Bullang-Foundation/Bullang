{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Bullang",
  "scopeName": "source.bullang",
  "fileTypes": ["bu"],

  "_comment": [
    "This grammar is the reference token model for Bullang. The tree-sitter",
    "queries (Zed, Helix, Neovim) and the Vim syntax file mirror it, so a change",
    "here should be made in all of them.",
    "",
    "It is kept honest against three things: bullang/src/grammar.pest for the",
    "shape of the language, `bullarchy stdlib` for the builtin names, and the",
    "rank_val / lang_val rules for the directive values. Everything it used to",
    "claim beyond those has been removed: i8..u128, usize, f32, char and str are",
    "not Bullang types, Vec/Option/Result/Fn/Box/HashMap were removed from the",
    "language, and #blueprint is not a directive."
  ],

  "patterns": [
    { "include": "#comment" },
    { "include": "#native_block" },
    { "include": "#directive" },
    { "include": "#declaration" },
    { "include": "#struct_enum" },
    { "include": "#inventory_entry" },
    { "include": "#builtin" },
    { "include": "#binding" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#type" },
    { "include": "#operator" },
    { "include": "#call" }
  ],

  "repository": {
    "comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.bullang"
    },

    "native_block": {
      "_comment": "Opaque by design: contents are another language and Bullang never reads them.",
      "begin": "^\\s*(@)(rust|python|c|cpp|go|java)\\s*$",
      "beginCaptures": {
        "0": { "name": "keyword.control.native.begin.bullang" }
      },
      "end": "^\\s*(@end)\\s*$",
      "endCaptures": {
        "0": { "name": "keyword.control.native.end.bullang" }
      },
      "name": "meta.embedded.block.bullang",
      "contentName": "comment.block.embedded.bullang"
    },

    "directive": {
      "patterns": [
        {
          "match": "(#rank)\\s*(:)\\s*(war|theater|battle|strategy|tactic|skirmish)\\s*(;)",
          "captures": {
            "1": { "name": "keyword.control.directive.bullang" },
            "2": { "name": "punctuation.separator.bullang" },
            "3": { "name": "storage.modifier.rank.bullang" },
            "4": { "name": "punctuation.terminator.bullang" }
          }
        },
        {
          "match": "(#lang)\\s*(:)\\s*(rs|py|cpp|c|go|java)\\s*(;)",
          "captures": {
            "1": { "name": "keyword.control.directive.bullang" },
            "2": { "name": "punctuation.separator.bullang" },
            "3": { "name": "constant.language.lang.bullang" },
            "4": { "name": "punctuation.terminator.bullang" }
          }
        },
        {
          "_comment": "#lib is a native header or import of the target language; #use is a Bullang package. Different things, coloured differently.",
          "match": "(#lib)\\s*(:)\\s*([^;\\n]+)\\s*(;)",
          "captures": {
            "1": { "name": "keyword.control.directive.bullang" },
            "2": { "name": "punctuation.separator.bullang" },
            "3": { "name": "string.unquoted.lib.bullang" },
            "4": { "name": "punctuation.terminator.bullang" }
          }
        },
        {
          "match": "(#use)\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(;)",
          "captures": {
            "1": { "name": "keyword.control.directive.bullang" },
            "2": { "name": "punctuation.separator.bullang" },
            "3": { "name": "entity.name.namespace.package.bullang" },
            "4": { "name": "punctuation.terminator.bullang" }
          }
        }
      ]
    },

    "declaration": {
      "match": "\\b(let)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.bullang" },
        "2": { "name": "entity.name.function.bullang" }
      }
    },

    "struct_enum": {
      "match": "\\b(struct|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.bullang" },
        "2": { "name": "entity.name.type.bullang" }
      }
    },

    "inventory_entry": {
      "_comment": "`parser : parse_line, parse_word;` — a file, then the functions it holds.",
      "match": "^\\s*([a-z_][a-zA-Z0-9_]*)\\s*(:)\\s*(?=[a-zA-Z_][a-zA-Z0-9_]*\\s*(,|;))",
      "captures": {
        "1": { "name": "entity.other.attribute-name.bullang" },
        "2": { "name": "punctuation.separator.bullang" }
      }
    },

    "builtin": {
      "patterns": [
        {
          "_comment": "Known builtins, from `bullarchy stdlib`. A name outside this set is still highlighted, but as an unknown builtin — which is a useful signal in itself.",
          "match": "\\b(builtin)(::)(argc|args|close|ends_with|env|exit|i64_to_str|in|len|max|min|open|out|replace_str|run|sleep|starts_with|str_to_i64|swap|tern|time|to_lower|to_upper|trim)\\b",
          "captures": {
            "1": { "name": "support.class.builtin.bullang" },
            "2": { "name": "punctuation.accessor.bullang" },
            "3": { "name": "support.function.builtin.bullang" }
          }
        },
        {
          "match": "\\b(builtin)(::)([a-z_][a-z_0-9]*)\\b",
          "captures": {
            "1": { "name": "support.class.builtin.bullang" },
            "2": { "name": "punctuation.accessor.bullang" },
            "3": { "name": "invalid.deprecated.unknown-builtin.bullang" }
          }
        }
      ]
    },

    "binding": {
      "_comment": "-> {name} names the bullet's result; -> {} discards it.",
      "match": "(->)\\s*(\\{)\\s*([a-zA-Z_][a-zA-Z0-9_]*)?\\s*(\\})",
      "captures": {
        "1": { "name": "keyword.operator.arrow.bullang" },
        "2": { "name": "punctuation.definition.binding.bullang" },
        "3": { "name": "variable.other.binding.bullang" },
        "4": { "name": "punctuation.definition.binding.bullang" }
      }
    },

    "string": {
      "begin": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.bullang" } },
      "end": "\"",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.bullang" } },
      "name": "string.quoted.double.bullang",
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.bullang" },
        {
          "_comment": "{name} interpolates a binding; {{ and }} are literal braces.",
          "match": "\\{\\{|\\}\\}",
          "name": "constant.character.escape.bullang"
        },
        {
          "match": "(\\{)([a-zA-Z_][a-zA-Z0-9_]*)(\\})",
          "captures": {
            "1": { "name": "punctuation.definition.template-expression.bullang" },
            "2": { "name": "variable.other.interpolated.bullang" },
            "3": { "name": "punctuation.definition.template-expression.bullang" }
          }
        }
      ]
    },

    "number": {
      "patterns": [
        { "match": "\\b-?\\d+\\.\\d+\\b", "name": "constant.numeric.float.bullang" },
        { "match": "\\b-?\\d+\\b", "name": "constant.numeric.integer.bullang" }
      ]
    },

    "type": {
      "patterns": [
        {
          "_comment": "Every type Bullang has. There are no others.",
          "match": "\\b(i64|f64|bool|String)\\b",
          "name": "support.type.primitive.bullang"
        },
        {
          "_comment": "Tuple is the only bracketed type left; Vec, Option, Result, Fn, Box and HashMap were removed from the language.",
          "match": "\\b(Tuple)(?=\\[)",
          "name": "support.type.generic.bullang"
        },
        { "match": "\\b(true|false)\\b", "name": "constant.language.boolean.bullang" },
        {
          "_comment": "Direction.North — an enum variant.",
          "match": "\\b([A-Z][a-zA-Z0-9_]*)(\\.)([A-Z][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "entity.name.type.enum.bullang" },
            "2": { "name": "punctuation.accessor.bullang" },
            "3": { "name": "variable.other.enummember.bullang" }
          }
        },
        {
          "_comment": "A capitalised name in type position: a struct or enum from inventory.bu.",
          "match": "(:)\\s*([A-Z][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "punctuation.separator.type.bullang" },
            "2": { "name": "entity.name.type.bullang" }
          }
        },
        {
          "match": "([a-z_][a-zA-Z0-9_]*)\\s*(:)\\s*(?=\\(|Tuple|i64|f64|bool|String|[A-Z])",
          "captures": {
            "1": { "name": "variable.parameter.bullang" },
            "2": { "name": "punctuation.separator.type.bullang" }
          }
        }
      ]
    },

    "operator": {
      "patterns": [
        { "match": "->", "name": "keyword.operator.arrow.bullang" },
        { "match": "\\.\\.", "name": "keyword.operator.range.bullang" },
        { "match": "(==|!=|<=|>=|&&|\\|\\||[+\\-*/%<>!])", "name": "keyword.operator.bullang" }
      ]
    },

    "call": {
      "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "name": "entity.name.function.call.bullang"
    }
  }
}
